def evaluate_model(model, X_train, y_train, X_test, y_test, label):
    rows = []
    for part, (A, b) in {"Train": (X_train, y_train), "Test": (X_test, y_test)}.items():
        pred = model.predict(A)
        rows.append({
            "Model": label,
            "Data": part,
            "R²": r2_score(b, pred),
            "RMSE": np.sqrt(mean_squared_error(b, pred)),
